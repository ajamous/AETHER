# SGP.22 ASN.1 codec build.
#
# Two outputs:
#   1. C code generated by asn1c into ./generated/c/ (consumed via cgo
#      where Go's encoding/asn1 cannot represent a type fully)
#   2. The Go package in ./go/ (hand-written types for the common path,
#      tested by `go test` from the workspace)

ASN1C       ?= asn1c
ASN1C_FLAGS ?= -fcompound-names -fno-include-deps -gen-PER -no-gen-example
MODULES_DIR := modules
OUT_DIR     := generated/c

ASN_FILES   := $(wildcard $(MODULES_DIR)/*.asn)

.PHONY: gen
gen: c-gen
	@echo "==> SGP.22 ASN.1 generation complete"

.PHONY: c-gen
c-gen: ## Generate C codec from .asn modules.
	@set -e; \
	if [ -z "$(ASN_FILES)" ]; then \
	  echo "no .asn modules under $(MODULES_DIR) yet; nothing to generate"; \
	  exit 0; \
	fi; \
	if ! command -v $(ASN1C) >/dev/null 2>&1; then \
	  echo "error: asn1c not found on PATH"; \
	  echo "       hint: install from https://github.com/vlm/asn1c"; \
	  echo "       (Go-side hand-written codecs still build without it)"; \
	  exit 1; \
	fi; \
	mkdir -p $(OUT_DIR); \
	cd $(OUT_DIR) && $(ASN1C) $(ASN1C_FLAGS) $(addprefix ../../,$(ASN_FILES))

.PHONY: clean
clean:
	rm -rf $(OUT_DIR)
