      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum by (reason) (increase(aether_gateway_es2plus_unauthorized_total[$__range]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "title": "401 reason mix (range)",
