      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {"options": {"0": {"color": "red", "index": 0, "text": "SCRAPE FAILING"}}, "type": "value"},
            {"options": {"1": {"color": "green", "index": 1, "text": "OK"}}, "type": "value"}
          ],
          "thresholds": {
            "mode": "absolute",
