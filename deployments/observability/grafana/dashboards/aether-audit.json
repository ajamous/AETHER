  "description": "Audit chain integrity and growth. The audit service is the single most SAS-SM-relevant component on the platform: a chain break is always Sev-1, regardless of customer impact. This dashboard surfaces the chain's status, length, and append rate alongside the scrape-up signal so on-call can tell `silent` apart from `green`. Backed by aether_audit_chain_ok, aether_audit_chain_length, and the standard up{aether_component=\"audit\"} probe.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Audit hash-chain integrity. 1 = OK, 0 = broken. AetherAuditChainBroken fires immediately on 0 — always Sev-1 per docs/sas-sm/incident-response.md.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {"options": {"0": {"color": "red", "index": 0, "text": "BROKEN"}}, "type": "value"},
            {"options": {"1": {"color": "green", "index": 1, "text": "OK"}}, "type": "value"}
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value"
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "aether_audit_chain_ok",
          "legendFormat": "chain ok",
          "refId": "A"
        }
      ],
      "title": "Chain integrity",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
